rules_version = '2';

// Seguridad Stiven7ink:
// - Contenido público (portfolio, blog, hero carousel, ocupación de agenda) solo lectura para todos.
// - Datos sensibles (citas completas, mensajes de contacto) solo admin (email en isAdmin).
// - Escrituras públicas limitadas: nuevas solicitudes de cita (batch con busySlots), mensajes de contacto.
//
// busySlots: create público acotado (necesario para batch anónimo de citas). Riesgo residual:
// bloqueo de franjas sin cita → mitigar con CAPTCHA post-lanzamiento (ver PRE_LANZAMIENTO.md).
//
// Despliegue: firebase deploy --only firestore:rules,storage

service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null;
    }

    // Debe coincidir con environment.adminEmails (mismo correo que en Firebase Auth).
    function isAdmin() {
      return signedIn()
        && request.auth.token.email == 'Harolstiven110@gmail.com';
    }

    function isValidYmd(d) {
      return d is string && d.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$');
    }

    function isAllowedTimeSlot(ts) {
      return ts is string && ts in ['manana', 'tarde', 'noche'];
    }

    function isValidBusySlotData() {
      return request.resource.data.keys().hasOnly(['date', 'timeSlot'])
        && isValidYmd(request.resource.data.date)
        && isAllowedTimeSlot(request.resource.data.timeSlot);
    }

    match /busySlots/{slotId} {
      allow read: if true;
      allow create: if isValidBusySlotData()
        && slotId == request.resource.data.date + '_' + request.resource.data.timeSlot;
      allow update: if false;
      allow delete: if isAdmin();
    }

    match /appointments/{docId} {
      allow read: if isAdmin();
      allow create: if request.resource.data.keys().hasOnly([
          'name', 'email', 'phone', 'date', 'timeSlot', 'style', 'size', 'description',
          'referenceImageUrl', 'status', 'createdAt'
        ])
        && request.resource.data.status == 'pending'
        && request.resource.data.name is string
        && request.resource.data.name.size() > 0 && request.resource.data.name.size() <= 120
        && request.resource.data.email is string
        && request.resource.data.email.size() <= 320
        && request.resource.data.phone is string
        && request.resource.data.phone.size() <= 40
        && isValidYmd(request.resource.data.date)
        && isAllowedTimeSlot(request.resource.data.timeSlot)
        && request.resource.data.style is string && request.resource.data.style.size() <= 120
        && request.resource.data.size is string && request.resource.data.size() <= 120
        && request.resource.data.description is string && request.resource.data.description.size() <= 8000
        && request.resource.data.createdAt is timestamp
        && (
          !('referenceImageUrl' in request.resource.data)
          || request.resource.data.referenceImageUrl == null
          || (request.resource.data.referenceImageUrl is string
              && request.resource.data.referenceImageUrl.size() <= 2000)
        );
      allow update, delete: if isAdmin();
    }

    match /portfolio/{docId} {
      allow read: if true;
      allow create, update, delete: if isAdmin();
    }

    match /blog/{docId} {
      allow read: if true;
      allow create, update, delete: if isAdmin();
    }

    match /heroCarousel/{docId} {
      allow read: if true;
      allow create, update, delete: if isAdmin();
    }

    match /contacts/{docId} {
      allow read: if isAdmin();
      allow create: if request.resource.data.keys().hasOnly([
          'name', 'email', 'subject', 'message', 'read', 'createdAt'
        ])
        && request.resource.data.read == false
        && request.resource.data.name is string
        && request.resource.data.name.size() > 0 && request.resource.data.name.size() <= 120
        && request.resource.data.email is string
        && request.resource.data.email.size() <= 320
        && request.resource.data.subject is string
        && request.resource.data.subject.size() <= 200
        && request.resource.data.message is string
        && request.resource.data.message.size() > 0 && request.resource.data.message.size() <= 8000
        && request.resource.data.createdAt is timestamp;
      allow update, delete: if isAdmin();
    }

    match /tattooTouristCities/{docId} {
      allow read: if true;
      allow create, update, delete: if isAdmin();
    }
  }
}
