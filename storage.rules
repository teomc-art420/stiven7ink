rules_version = '2';

// Despliegue: firebase deploy --only firestore:rules,storage
//
// portfolio / heroCarousel / blog / tattoo-tourist: lectura pública; escritura solo admin.
// appointments: referencias de imagen desde el formulario público (imagen ≤ 5MB, solo image/*).
// Riesgo residual de abuso de almacenamiento → CAPTCHA post-lanzamiento.

service firebase.storage {
  match /b/{bucket}/o {

    function signedIn() {
      return request.auth != null;
    }

    // Comparación en minúsculas + email verificado (cuenta única del estudio).
    function isAdmin() {
      return signedIn()
        && request.auth.token.email != null
        && request.auth.token.email.lower() == 'harolstiven110@gmail.com'
        && request.auth.token.email_verified == true;
    }

    function isImageUpload() {
      return request.resource != null
        && request.resource.size < 5 * 1024 * 1024
        && request.resource.contentType.matches('image/.*');
    }

    match /portfolio/{allPaths=**} {
      allow read: if true;
      allow write, delete: if isAdmin();
    }

    match /heroCarousel/{allPaths=**} {
      allow read: if true;
      allow write, delete: if isAdmin();
    }

    match /blog/{allPaths=**} {
      allow read: if true;
      allow write, delete: if isAdmin();
    }

    match /appointments/{allPaths=**} {
      allow read: if isAdmin();
      allow write: if isImageUpload();
      allow delete: if isAdmin();
    }

    match /tattoo-tourist/{allPaths=**} {
      allow read: if true;
      allow write, delete: if isAdmin() && isImageUpload();
    }
  }
}
